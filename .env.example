# Copy to .env and edit. Every value is optional.
# BiliSonic reads .env from the repository root (never commit .env).

# Where finished audio files are written. Default: ./output
# BILI_OUTPUT_DIR=/Users/you/Music/Bilibili

# Local web server. Keep 127.0.0.1 unless you understand the risk: there is no auth.
BILI_HOST=127.0.0.1
BILI_PORT=8765

# Default output format: flac | wav | m4a
# flac = lossless container (re-encodes lossy sources without further quality loss)
# m4a  = keep the source audio untouched when it is already AAC
BILI_AUDIO_FORMAT=flac

# Number of videos processed in parallel. 1 is recommended on a fanless Air.
BILI_MAX_CONCURRENT=1
# Maximum task records kept in memory (clear finished tasks from the UI to reset).
BILI_MAX_TASKS=300
# Retries per candidate URL before falling back/downgrading.
BILI_DOWNLOAD_RETRIES=3

# Optional login cookie. Needed for Hi-Res FLAC / Dolby / some high bitrate audio.
# Preferred: use the web UI -> 登录账号, which validates and stores the cookie in
# ~/.config/bilisonic/cookie.json with mode 0600. The UI-managed cookie takes
# precedence over the variables below; logout from the UI falls back to them.
# Environment/file options remain for advanced/headless use:
# BILI_COOKIE=SESSDATA=xxxx; bili_jct=xxxx; buvid3=xxxx
# BILI_SESSDATA=xxxx
# BILI_COOKIE_FILE=/Users/you/cookies.txt
# BILI_CONFIG_DIR=/Users/you/.config/bilisonic

# Account safety mode: one task at a time plus a randomized pause between tasks.
# Turning this off (BILI_SAFE_MODE=false) can increase account risk.
BILI_SAFE_MODE=true
BILI_TASK_INTERVAL=3

# Optional network settings
# BILI_PROXY=http://127.0.0.1:7890
# BILI_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) ...
# BILI_FFMPEG=/opt/homebrew/bin/ffmpeg
# BILI_FFPROBE=/opt/homebrew/bin/ffprobe

# Logging: DEBUG | INFO | WARNING | ERROR
BILI_LOG_LEVEL=INFO
